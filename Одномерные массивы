def StrToNums(Str):
    temp = []
    for n in Str.split():
        temp.append(int(n))

    return temp

def F1():
    nums = StrToNums(input("Введите числа: "))

    print(nums[::-1])

def F2():
    nums = StrToNums(input("Введите числа: "))

    print("Чётные -", nums[1::2])
    print("Нечётные -", nums[::2])

def F3():
    nums = StrToNums(input("Введите числа: "))

    chet = []
    nechet = []

    for n in nums:
        if n%2 == 0 or n == 0:
            chet.append(n)
        else:
            nechet.append(n)

    print("Чётные -", len(chet))
    print("Нечётные -", len(nechet))

