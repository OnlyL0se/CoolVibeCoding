def CreateList(nm, Type):
    if not Type:
        DoubleTrouble = []
        for n in range(nm[0]):
            DoubleTrouble.append([])
            if n == 0:
                for i in range(1, nm[1]+1): DoubleTrouble[n].append(i)
            else:
                for i in range(nm[1]*n+1,nm[1]*n+1+nm[1]): DoubleTrouble[n].append(i)
        return DoubleTrouble
    elif Type == "01":
        DoubleTrouble = []
        for i in range(nm[0]):
            DoubleTrouble.append([])
            for j in range(nm[1]):
                DoubleTrouble[i].append(random.randint(0,1))
        return DoubleTrouble

