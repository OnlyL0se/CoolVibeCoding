def F5():
    AGCT = input("Введите цепочку ДНК: ")
    A,G,C,T = 0,0,0,0
    for sumbol in AGCT:
        if sumbol == "А":
            A += 1
        elif sumbol == "Г":
            G += 1
        elif sumbol == 'Ц':
            C += 1
        else:
            T += 1
    print(f"Аденин - {A}\nГуанин - {G}\nЦитозин - {C}\nТимин - {T}")

