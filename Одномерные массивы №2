def F5():
    nums = StrToNums(input("Введите числа: "))

    for i in range(len(nums)):
        Current = nums[i]
        MIN, MINindex = nums[i], 0

        for j in range(i, len(nums)):
            if nums[j] < MIN:
                MIN = nums[j]
                MINindex = j

        if sorted(nums) == nums:
            return print(nums)

        nums[MINindex] = Current
        nums[i] = MIN

def F6():
    nums = StrToNums(input("Введите числа: "))

    for _ in range(len(nums)):
        for i, num in enumerate(nums):
            if i+1 == len(nums): break
            if nums[i+1] < num:
                nums[i] = nums[i+1]
                nums[i+1] = num
