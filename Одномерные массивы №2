def StrToNums(Str):
    temp = []
    for n in Str.split():
        temp.append(int(n))

    return temp

def F1():
    nums = StrToNums(input("Введите числа: "))
    NoReply = []
    MaxReply = 0

    for num in nums:
        if not num in NoReply:
            NoReply.append(num)

    for NRNum in NoReply:
        Count = 0
        for num in nums:
            if NRNum == num: Count += 1

        MaxReply = Count > MaxReply and Count or MaxReply
    print(MaxReply)

def F2():
    nums = StrToNums(input("Введите числа: "))

    flag = True
    SORTED = sorted(nums)
    for i, num in enumerate(SORTED):
        if i+1 == len(SORTED): break

        if i == 0 and num != 1:
            flag = False
        elif num+1 != SORTED[i+1]:
            flag = False
    print(flag)

def F3():
    nums = StrToNums(input("Введите числа: "))

    MaxUpLen = 1
    UpLen = 1
    for i, num in enumerate(nums):
        if i+1 == len(nums):
            MaxUpLen = MaxUpLen < UpLen and UpLen or MaxUpLen
            break

        if num < nums[i+1]:
            UpLen += 1
        else:
            UpLen = 1
            MaxUpLen = MaxUpLen < UpLen and UpLen or MaxUpLen
    print(MaxUpLen)

